<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameBouncer\FrameBouncer.csproj" />
  </ItemGroup>
  <!-- Testbarer Updater-Kern (Update-Spec Punkt 20): Der Installationskern lebt
       seit dem Single-EXE-Umbau in der App (FrameBouncer\Updater\UpdateInstallerCore.cs)
       und wird über den Projektverweis mitkompiliert – Replace/Rollback/Path-Traversal
       werden gegen echte Temp-Verzeichnisse getestet. -->

</Project>
